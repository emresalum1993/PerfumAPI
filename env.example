# .ENV File
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
DEBUG=True
FRONTEND_URL=http://localhost:5173

# OmniRoute (OpenAI-compatible local gateway) — used by /pipeline/reviews/score
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=
LLM_MODEL=auto

# Mood pipeline thresholds
PIPELINE_REVIEW_BLEND_THRESHOLD=20
PIPELINE_DISGUST_GATE=40
PIPELINE_VALENCE_FLOOR=40

# NRC-VAD lexicon (valence + dominance secondary source)
LEXICON_PATH=data/NRC-VAD-Lexicon-v2.1.txt
LEXICON_MIN_MATCHED_WORDS=5
LEXICON_BLEND_WEIGHT_LLM=0.65
PIPELINE_LEXICON_DIVERGENCE_THRESHOLD=25
REVIEW_HELPFULNESS_WEIGHT_CAP=5

# Pros/cons opinions (character-filtered) into mood posterior
LEXICON_MIN_MATCHED_WORDS_OPINIONS=3
PROS_CONS_WEIGHT_CAP=8

# AI overview (original synthesis; separate from mood scoring)
AI_OVERVIEW_MAX_REVIEWS_PER_SENTIMENT=20
AI_OVERVIEW_REVIEW_CHAR_LIMIT=600
AI_OVERVIEW_MAX_ATTEMPTS=3
AI_OVERVIEW_TEMPERATURE=0.3

# Optional: paste Chrome DevTools cookie string to reuse Cloudflare clearance (same IP as browser)
# Manual cookies override Playwright profile when set.
FRAGRANTICA_COOKIES=
FRAGRANTICA_USER_AGENT=
FRAGRANTICA_DELAY=3

# Playwright persistent Chrome profile (recommended)
# 1. Set USE_PLAYWRIGHT_SESSION=true
# 2. Run: python scripts/bootstrap_fragrantica_session.py
# 3. Pass Cloudflare in the opened Chrome window, press Enter
# 4. Run scraper/API — cookies load from .pw-fragrantica/exported_session.json
USE_PLAYWRIGHT_SESSION=false
FRAGRANTICA_PW_USER_DATA=.pw-fragrantica
FRAGRANTICA_PW_CHANNEL=chrome
FRAGRANTICA_PW_AUTO_REFRESH=true
FRAGRANTICA_PW_BOOTSTRAP_URL=https://www.fragrantica.com
FRAGRANTICA_PW_TIMEOUT=60

# Headed Chrome for ALL scrapes (page loads visible; AJAX uses the same profile cookies).
# Implies Playwright profile; FRAGRANTICA_COOKIES is ignored while this is true.
# parallel_reviews still works but Chrome fetches are serialized on one tab.
FRAGRANTICA_PW_SCRAPE=false

# Optional: auto-solve Cloudflare via cloudscraper (weak fallback; failed on Fragrantica spike test)
USE_CLOUDSCRAPER=false
FRAGRANTICA_CLOUDSCRAPER_DEBUG=false
FRAGRANTICA_CLOUDSCRAPER_INTERPRETER=js2py

# Thumbnail background removal (saved under data/images/nobg/{fragrantica_id}.png)
# DB image_url unchanged; first run downloads u2net model (~170MB).
IMAGE_NOBG=true
IMAGE_NOBG_DIR=data/images/nobg
IMAGE_NOBG_MODEL=u2net
IMAGE_NOBG_FORCE=false
IMAGE_NOBG_BATCH_LIMIT=500
IMAGE_NOBG_UPLOAD=true
IMAGE_NOBG_BUCKET=perfume-thumbs
